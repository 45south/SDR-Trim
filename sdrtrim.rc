/* sdrtrim.rc - resource file for SDR Trim */

#include <windows.h>

#define RT_MANIFEST  24
#define CREATEPROCESS_MANIFEST_RESOURCE_ID  1

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "sdrtrim.manifest"

/* Version information */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION      1,6,3,0
 PRODUCTVERSION   1,6,3,0
 FILEFLAGSMASK    VS_FFI_FILEFLAGSMASK
 FILEFLAGS        0x0L
 FILEOS           VOS_NT_WINDOWS32
 FILETYPE         VFT_APP
 FILESUBTYPE      VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "45south"
            VALUE "FileDescription",  "SDR Trim - IQ Recording Converter"
            VALUE "FileVersion",      "1.6.3.0"
            VALUE "InternalName",     "sdrtrim"
            VALUE "LegalCopyright",   "Copyright (C) 2026 45south"
            VALUE "OriginalFilename", "sdrtrim.exe"
            VALUE "ProductName",      "SDR Trim"
            VALUE "ProductVersion",   "1.6.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
